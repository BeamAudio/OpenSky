  <propulsion>
    <engine file="IO-360-L2A">
      <feed>0</feed>
      <feed>1</feed>
      <thruster file="mccauley_76">
        <location unit="IN">
          <x>-47</x>
          <y>0</y>
          <z>2</z>
        </location>
        <orient unit="DEG">
          <roll>0</roll>
          <pitch>0</pitch>
          <yaw>0</yaw>
        </orient>
        <sense>1</sense>
        <p_factor>8</p_factor>
      </thruster>
    </engine>
    <tank number="0" type="FUEL">
      <location unit="IN">
        <x>46</x>
        <y>-33</y>
        <z>19</z>
      </location>
      <capacity unit="LBS">159</capacity>
      <contents unit="LBS">126</contents>
    </tank>
    <tank number="1" type="FUEL">
      <location unit="IN">
        <x>46</x>
        <y>33</y>
        <z>19</z>
      </location>
      <capacity unit="LBS">159</capacity>
      <contents unit="LBS">126</contents>
    </tank>
  </propulsion>
  <flight_control name="C172S mechanical controls">
    <property value="0">opensky/weather/p-gust-rad-s</property>
    <property value="0">opensky/weather/q-gust-rad-s</property>
    <property value="0">opensky/weather/r-gust-rad-s</property>
    <property value="0">opensky/weather/ice-factor</property>
    <property value="0">opensky/weather/rain-drag</property>
    <channel name="Primary surfaces">
      <summer name="Elevator with trim">
        <input>fcs/elevator-cmd-norm</input>
        <input>fcs/pitch-trim-cmd-norm</input>
        <clipto>
          <min>-1</min>
          <max>1</max>
        </clipto>
        <output>opensky/fcs/elevator-total</output>
      </summer>
      <aerosurface_scale name="Elevator">
        <input>opensky/fcs/elevator-total</input>
        <range>
          <min>-0.43633</min>
          <max>0.43633</max>
        </range>
        <output>fcs/elevator-pos-rad</output>
      </aerosurface_scale>
      <aerosurface_scale name="Left aileron">
        <input>fcs/aileron-cmd-norm</input>
        <range>
          <min>-0.34907</min>
          <max>0.34907</max>
        </range>
        <output>fcs/left-aileron-pos-rad</output>
      </aerosurface_scale>
      <aerosurface_scale name="Right aileron">
        <input>-fcs/aileron-cmd-norm</input>
        <range>
          <min>-0.34907</min>
          <max>0.34907</max>
        </range>
        <output>fcs/right-aileron-pos-rad</output>
      </aerosurface_scale>
      <aerosurface_scale name="Rudder">
        <input>fcs/rudder-cmd-norm</input>
        <range>
          <min>-0.34907</min>
          <max>0.34907</max>
        </range>
        <output>fcs/rudder-pos-rad</output>
      </aerosurface_scale>
      <aerosurface_scale name="Flaps">
        <input>fcs/flap-cmd-norm</input>
        <zero_centered>false</zero_centered>
        <domain>
          <min>0</min>
          <max>1</max>
        </domain>
        <range>
          <min>0</min>
          <max>0.5236</max>
        </range>
        <output>fcs/flap-pos-rad</output>
      </aerosurface_scale>
    </channel>
  </flight_control>
  <aerodynamics>
    <alphalimits unit="DEG">
      <min>-13</min>
      <max>15.5</max>
    </alphalimits>
    <!-- A barely moving aircraft can have a nonzero airspeed from floating
         point roundoff. Bound 1/(2V) before evaluating rate derivatives,
         especially the lift term that is squared in induced drag. -->
    <function name="opensky/aero/twice-speed">
      <max>
        <value>20.0</value>
        <product><value>2.0</value><property>velocities/vt-fps</property></product>
      </max>
    </function>
    <function name="opensky/aero/pitch-rate-scale">
      <quotient><property>metrics/cbarw-ft</property><property>opensky/aero/twice-speed</property></quotient>
    </function>
    <function name="opensky/aero/span-rate-scale">
      <quotient><property>metrics/bw-ft</property><property>opensky/aero/twice-speed</property></quotient>
    </function>
    <function name="opensky/aero/alpha-effective">
      <description>Positive flap reduces the effective angle to the stall boundary.</description>
      <sum>
        <property>aero/alpha-rad</property>
            <product>
          <value>0.0436</value>
          <property>fcs/flap-cmd-norm</property>
            </product>
      </sum>
    </function>
    <function name="opensky/aero/ground-drag-factor">
      <description>Induced drag reduction against span-normalized ground clearance.</description>
      <table>
        <independentVar lookup="row">aero/h_b-mac-ft</independentVar>
        <tableData>
            0.0000    0.4400
            0.1000    0.5400
            0.2000    0.6800
            0.4000    0.8400
            0.8000    0.9700
            1.2000    1.0000
        </tableData>
      </table>
    </function>
    <function name="opensky/aero/wing-lift">
      <description>Piecewise lift curve with separated flow beyond the stall.</description>
      <table>
        <independentVar lookup="row">opensky/aero/alpha-effective</independentVar>
        <tableData>
           -1.5700   -0.0800
           -0.7500   -0.6000
           -0.4000   -0.5900
           -0.2400   -0.8700
           -0.1500   -0.4630
            0.0000    0.3100
            0.1200    0.9280
            0.2300    1.4940
            0.2700    1.6900
            0.3200    1.2400
            0.4100    0.9200
            0.6500    0.5400
            1.5700    0.0000
        </tableData>
      </table>
    </function>
    <function name="opensky/aero/CL">
      <description>Lift coefficient including flap, tail, pitch-rate and ice/rain contamination.</description>
      <product>
        <difference>
          <value>1.0</value>
          <sum>
            <product>
              <value>0.24</value>
              <property>opensky/weather/ice-factor</property>
            </product>
            <product>
              <value>0.04</value>
              <property>opensky/weather/rain-drag</property>
            </product>
          </sum>
        </difference>
        <sum>
          <property>opensky/aero/wing-lift</property>
          <product>
            <value>0.26</value>
            <property>fcs/flap-cmd-norm</property>
          </product>
          <product>
            <value>0.42</value>
            <property>fcs/elevator-pos-rad</property>
          </product>
          <product>
            <value>3.9</value>
            <product>
              <property>opensky/aero/pitch-rate-scale</property>
              <difference>
                <property>velocities/q-aero-rad_sec</property>
                <property>opensky/weather/q-gust-rad-s</property>
              </difference>
            </product>
          </product>
        </sum>
      </product>
    </function>
    <function name="opensky/aero/CD">
      <description>Profile, induced, flap, sideslip, ice/rain and post-stall drag.</description>
      <sum>
        <value>0.031</value>
        <product>
          <value>0.042</value>
          <property>opensky/weather/ice-factor</property>
        </product>
        <product>
          <value>0.008</value>
          <property>opensky/weather/rain-drag</property>
        </product>
        <product>
          <value>0.058</value>
          <property>fcs/flap-cmd-norm</property>
            </product>
        <product>
          <value>0.14</value>
          <property>aero/beta-rad</property>
            <property>aero/beta-rad</property>
            </product>
        <product>
          <value>0.0436</value>
          <property>opensky/aero/ground-drag-factor</property>
          <property>opensky/aero/CL</property>
          <property>opensky/aero/CL</property>
        </product>
        <table>
          <independentVar lookup="row">opensky/aero/alpha-effective</independentVar>
          <tableData>
           -1.5700    1.1000
           -0.4500    0.2400
           -0.2500    0.0500
            0.0000    0.0000
            0.2700    0.0000
            0.3500    0.1000
            0.4800    0.2400
            1.5700    1.1000
        </tableData>
        </table>
      </sum>
    </function>
    <axis name="LIFT">
      <function name="opensky/aero/lift">
        <description>Wing and tail lift.</description>
        <product>
          <property>aero/qbar-psf</property>
          <property>metrics/Sw-sqft</property>
          <property>opensky/aero/CL</property>
        </product>
      </function>
    </axis>
    <axis name="DRAG">
      <function name="opensky/aero/drag">
        <description>Airframe drag.</description>
        <product>
          <property>aero/qbar-psf</property>
          <property>metrics/Sw-sqft</property>
          <property>opensky/aero/CD</property>
        </product>
      </function>
    </axis>
    <axis name="SIDE">
      <function name="opensky/aero/side">
        <description>Fuselage and rudder side force.</description>
        <product>
          <property>aero/qbar-psf</property>
          <property>metrics/Sw-sqft</property>
          <sum>
            <product>
              <value>-0.39</value>
              <property>aero/beta-rad</property>
            </product>
            <product>
              <value>-0.187</value>
              <property>fcs/rudder-pos-rad</property>
            </product>
          </sum>
        </product>
      </function>
    </axis>
    <axis name="ROLL">
      <function name="opensky/aero/roll">
        <description>Dihedral, roll damping, yaw coupling and controls.</description>
        <product>
          <property>aero/qbar-psf</property>
          <property>metrics/Sw-sqft</property>
          <property>metrics/bw-ft</property>
          <sum>
            <product>
              <value>-0.092</value>
              <property>aero/beta-rad</property>
            </product>
            <product>
              <value>-0.48</value>
              <product>
                <property>opensky/aero/span-rate-scale</property>
                <difference>
                  <property>velocities/p-aero-rad_sec</property>
                  <property>opensky/weather/p-gust-rad-s</property>
                </difference>
              </product>
            </product>
            <product>
              <value>0.11</value>
              <product>
                <property>opensky/aero/span-rate-scale</property>
                <difference>
                  <property>velocities/r-aero-rad_sec</property>
                  <property>opensky/weather/r-gust-rad-s</property>
                </difference>
              </product>
            </product>
            <product>
              <value>0.178</value>
              <property>fcs/left-aileron-pos-rad</property>
            </product>
            <product>
              <value>0.015</value>
              <property>fcs/rudder-pos-rad</property>
            </product>
          </sum>
        </product>
      </function>
    </axis>
    <axis name="PITCH">
      <function name="opensky/aero/pitch">
        <description>Longitudinal stability, elevator, flaps and pitch damping.</description>
        <product>
          <property>aero/qbar-psf</property>
          <property>metrics/Sw-sqft</property>
          <property>metrics/cbarw-ft</property>
          <sum>
            <value>0.045</value>
            <product>
              <value>-0.89</value>
              <property>aero/alpha-rad</property>
            </product>
            <product>
              <value>-1.28</value>
              <property>fcs/elevator-pos-rad</property>
            </product>
            <product>
              <value>-12.4</value>
              <product>
                <property>opensky/aero/pitch-rate-scale</property>
                <difference>
                  <property>velocities/q-aero-rad_sec</property>
                  <property>opensky/weather/q-gust-rad-s</property>
                </difference>
              </product>
            </product>
            <product>
              <value>-0.085</value>
              <property>fcs/flap-cmd-norm</property>
            </product>
          </sum>
        </product>
      </function>
    </axis>
    <axis name="YAW">
      <function name="opensky/aero/yaw">
        <description>Directional stability, yaw damping and controls.</description>
        <product>
          <property>aero/qbar-psf</property>
          <property>metrics/Sw-sqft</property>
          <property>metrics/bw-ft</property>
          <sum>
            <product>
              <value>0.075</value>
              <property>aero/beta-rad</property>
            </product>
            <product>
              <value>-0.032</value>
              <product>
                <property>opensky/aero/span-rate-scale</property>
                <difference>
                  <property>velocities/p-aero-rad_sec</property>
                  <property>opensky/weather/p-gust-rad-s</property>
                </difference>
              </product>
            </product>
            <product>
              <value>-0.125</value>
              <product>
                <property>opensky/aero/span-rate-scale</property>
                <difference>
                  <property>velocities/r-aero-rad_sec</property>
                  <property>opensky/weather/r-gust-rad-s</property>
                </difference>
              </product>
            </product>
            <product>
              <value>-0.016</value>
              <property>fcs/left-aileron-pos-rad</property>
            </product>
            <product>
              <value>0.074</value>
              <property>fcs/rudder-pos-rad</property>
            </product>
          </sum>
        </product>
      </function>
    </axis>
  </aerodynamics>
</fdm_config>
